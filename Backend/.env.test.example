# Configuración de la base de datos de PRUEBAS.
# Copia este archivo como .env.test y ajusta las credenciales.
# El nombre de la base DEBE terminar en "_test": las pruebas se niegan a
# ejecutarse contra cualquier otra base para no tocar datos reales.
PORT=3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ferrogest_test
JWT_SECRET=cambia-esta-clave-de-pruebas-de-al-menos-32-caracteres
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
NODE_ENV=test
