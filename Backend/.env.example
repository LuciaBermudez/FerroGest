PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ferrogest
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# Orígenes del navegador autorizados, separados por coma.
# En producción debe incluir el dominio real del frontend.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Ponlo en true solo si la API está detrás de un proxy inverso
# (Railway, Render, Nginx...). Permite leer la IP real con X-Forwarded-For.
TRUST_PROXY=false
